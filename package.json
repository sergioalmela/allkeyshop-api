{
  "name": "allkeyshop-api",
  "version": "3.0.0",
  "description": "Unofficial Allkeyshop API",
  "main": "dist/src/allkeyshop.js",
  "types": "dist/src/allkeyshop.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "check": "biome check --write",
    "test": "npm run typecheck && npm run build && jest --verbose"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sergioalmela/allkeyshop-api"
  },
  "keywords": [
    "allkeyshop.com",
    "www.allkeyshop.com",
    "api"
  ],
  "author": "Sergio Almela",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/sergioalmela/allkeyshop-api/issues"
  },
  "homepage": "https://github.com/sergioalmela/allkeyshop-api",
  "dependencies": {
    "fuzzy-search": "^3.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "^2.5.15",
    "@types/fuzzy-search": "^2.1.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  }
}
