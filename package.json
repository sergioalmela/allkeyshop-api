{
  "name": "allkeyshop-api",
  "version": "2.0.0",
  "description": "Unofficial Allkeyshop API",
  "main": "dist/src/allkeyshop.js",
  "types": "dist/src/allkeyshop.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "format": "biome format --write",
